# Copy this file to .env and paste your key. .env is git-ignored and never committed.
# Without a key Nirnay runs in keyword mode: tickets are sorted, but no replies are drafted.
ANTHROPIC_API_KEY=sk-ant-...

# Optional (defaults shown). See server/limits.py and DEPLOY.md.
# NIRNAY_PER_MINUTE=10                         # new tickets a minute per visitor, then HTTP 429
# NIRNAY_DAILY_AI_CALLS=100                    # AI triages a day; after that, keyword mode
# NIRNAY_WEB_ORIGINS=http://localhost:3000     # web app address(es) allowed to call the API
# NIRNAY_DB=data/nirnay.db                     # inbox database file
